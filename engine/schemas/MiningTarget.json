{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MiningTarget",
  "description": "A mining target attached to a station slot.",
  "type": "object",
  "properties": {
    "rate_remainder": {
      "$ref": "#/$defs/RationalRemainder"
    },
    "resource": {
      "$ref": "#/$defs/ResourceType"
    },
    "retune_ticks_remaining": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "slot_index": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "slot_index",
    "resource",
    "rate_remainder",
    "retune_ticks_remaining"
  ],
  "$defs": {
    "RationalRemainder": {
      "description": "Rational remainder for accumulator-based resource consumption.",
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "denominator"
      ]
    },
    "ResourceType": {
      "description": "The 25 resource types in canonical order (raw, refined, component).\n\nSerialized as a camelCase string (e.g. `\"metalOre\"`).  This enum's\n`Ord` follows the GDD 14 resource catalog order so that sparse maps\niterate deterministically.",
      "type": "string",
      "enum": [
        "metalOre",
        "carbonSoil",
        "siliconDust",
        "volcanicSulfur",
        "waterIce",
        "frozenGases",
        "helium3",
        "rareEarthMinerals",
        "crystalDeposits",
        "metals",
        "carbonFiber",
        "siliconWafers",
        "chemicals",
        "fuel",
        "alloys",
        "optics",
        "reactorRods",
        "structuralFrame",
        "powerCore",
        "controlSystem",
        "driveAssembly",
        "cargoModule",
        "researchLab",
        "constructionBay",
        "gateNode"
      ]
    }
  }
}