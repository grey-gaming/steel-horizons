{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShipDefinition",
  "description": "A ship definition in the content catalog.",
  "type": "object",
  "properties": {
    "build_work": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "component_cost": {
      "type": "object",
      "properties": {
        "alloys": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonFiber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonSoil": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cargoModule": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chemicals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "constructionBay": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "controlSystem": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "crystalDeposits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "driveAssembly": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frozenGases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gateNode": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "helium3": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metalOre": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "optics": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "powerCore": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rareEarthMinerals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reactorRods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "researchLab": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconDust": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconWafers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "structuralFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volcanicSulfur": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waterIce": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "name": {
      "type": "string"
    },
    "required_tech": {
      "$ref": "#/$defs/TechId"
    },
    "role": {
      "$ref": "#/$defs/ShipRole"
    },
    "stats": {
      "$ref": "#/$defs/ShipStats"
    },
    "tier": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "role",
    "tier",
    "name",
    "stats",
    "build_work",
    "required_tech"
  ],
  "$defs": {
    "ShipRole": {
      "description": "Role of a ship.",
      "type": "string",
      "enum": [
        "cargo",
        "construction",
        "research"
      ]
    },
    "ShipStats": {
      "description": "Ship statistics (role-dependent — see GDD 13 §Content Definitions).",
      "type": "object",
      "properties": {
        "base_mass": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "build_cargo_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "build_work_per_tick": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "cargo_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_survey_depth": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "speed_milli": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "survey_work_per_tick": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cargo_capacity",
        "build_cargo_capacity",
        "speed_milli",
        "max_fuel",
        "base_mass",
        "build_work_per_tick",
        "survey_work_per_tick",
        "max_survey_depth"
      ]
    },
    "TechId": {
      "description": "Unique identifier for a technology.",
      "type": "string"
    }
  }
}