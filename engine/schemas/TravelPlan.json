{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TravelPlan",
  "description": "A ship's full travel plan from origin to destination.",
  "type": "object",
  "properties": {
    "active_segment": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "destination": {
      "$ref": "#/$defs/DestinationRef"
    },
    "origin": {
      "$ref": "#/$defs/SystemPosition"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/TravelSegment"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "origin",
    "destination",
    "segments",
    "active_segment"
  ],
  "$defs": {
    "ArcDirection": {
      "description": "Direction along a lane arc.",
      "type": "string",
      "enum": [
        "clockwise",
        "counterClockwise"
      ]
    },
    "BodyId": {
      "description": "Unique identifier for a celestial body (e.g. `planet_haven`).",
      "type": "string"
    },
    "DestinationRef": {
      "description": "A destination for ship travel or logistics.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "body_id": {
              "$ref": "#/$defs/BodyId"
            },
            "type": {
              "type": "string",
              "const": "body"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "body_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "station"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "salvage_id": {
              "$ref": "#/$defs/SalvageId"
            },
            "type": {
              "type": "string",
              "const": "salvage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "salvage_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gateSite"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "LaneId": {
      "description": "Orbital lane identifiers in increasing orbital radius order.",
      "type": "string",
      "enum": [
        "inner",
        "habitable",
        "outer",
        "fringe"
      ]
    },
    "SalvageId": {
      "description": "Unique identifier for a salvage cache.",
      "type": "string"
    },
    "StationId": {
      "description": "Unique identifier for a station (e.g. `hub_haven`).",
      "type": "string"
    },
    "SystemPosition": {
      "description": "A position within the system: lane, orbital radius, and angle.",
      "type": "object",
      "properties": {
        "angle_milli": {
          "description": "Normalized 0..6282 milliradians (π × 2000).",
          "type": "integer",
          "format": "int32"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "radius_units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "lane_id",
        "radius_units",
        "angle_milli"
      ]
    },
    "TravelSegment": {
      "description": "One segment of a ship's travel plan.",
      "type": "object",
      "properties": {
        "arc_direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArcDirection"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/TravelSegmentKind"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "life_support_eligible": {
          "type": "boolean"
        },
        "remaining_distance_milli": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "speed_multiplier_den": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "speed_multiplier_num": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_distance_milli": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "lane_id",
        "total_distance_milli",
        "remaining_distance_milli",
        "speed_multiplier_num",
        "speed_multiplier_den",
        "life_support_eligible"
      ]
    },
    "TravelSegmentKind": {
      "description": "Kind of a single travel segment.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radialBurn"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "laneArc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}