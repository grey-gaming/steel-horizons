{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SalvageCache",
  "description": "A durable salvage cache holding recovered materials.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/SalvageId"
    },
    "inventory": {
      "type": "object",
      "properties": {
        "alloys": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonFiber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonSoil": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cargoModule": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chemicals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "constructionBay": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "controlSystem": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "crystalDeposits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "driveAssembly": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frozenGases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gateNode": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "helium3": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metalOre": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "optics": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "powerCore": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rareEarthMinerals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reactorRods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "researchLab": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconDust": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconWafers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "structuralFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volcanicSulfur": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waterIce": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "position": {
      "$ref": "#/$defs/SystemPosition"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "position"
  ],
  "$defs": {
    "LaneId": {
      "description": "Orbital lane identifiers in increasing orbital radius order.",
      "type": "string",
      "enum": [
        "inner",
        "habitable",
        "outer",
        "fringe"
      ]
    },
    "SalvageId": {
      "description": "Unique identifier for a salvage cache.",
      "type": "string"
    },
    "SystemPosition": {
      "description": "A position within the system: lane, orbital radius, and angle.",
      "type": "object",
      "properties": {
        "angle_milli": {
          "description": "Normalized 0..6282 milliradians (π × 2000).",
          "type": "integer",
          "format": "int32"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "radius_units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "lane_id",
        "radius_units",
        "angle_milli"
      ]
    }
  }
}