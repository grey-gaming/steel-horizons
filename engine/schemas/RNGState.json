{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RNGState",
  "description": "The xoshiro256** PRNG state (all-zero is invalid).",
  "type": "object",
  "properties": {
    "words": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "maxItems": 4,
      "minItems": 4
    }
  },
  "additionalProperties": false,
  "required": [
    "words"
  ]
}