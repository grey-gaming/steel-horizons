{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ship",
  "description": "A ship entity in the simulation.",
  "type": "object",
  "properties": {
    "base_mass": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "base_speed_milli": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "build_cargo": {
      "type": "object",
      "properties": {
        "alloys": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonFiber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonSoil": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cargoModule": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chemicals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "constructionBay": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "controlSystem": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "crystalDeposits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "driveAssembly": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frozenGases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gateNode": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "helium3": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metalOre": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "optics": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "powerCore": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rareEarthMinerals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reactorRods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "researchLab": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconDust": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconWafers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "structuralFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volcanicSulfur": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waterIce": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "build_cargo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "build_work_per_tick": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "cargo_amount": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "cargo_type": {
      "anyOf": [
        {
          "$ref": "#/$defs/ResourceType"
        },
        {
          "type": "null"
        }
      ]
    },
    "display_name": {
      "type": "string"
    },
    "docked_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/StationId"
        },
        {
          "type": "null"
        }
      ]
    },
    "fuel": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "fuel_efficiency_remainder": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "fuel_remainder": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "id": {
      "$ref": "#/$defs/ShipId"
    },
    "installed_components": {
      "type": "object",
      "properties": {
        "alloys": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonFiber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonSoil": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cargoModule": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chemicals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "constructionBay": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "controlSystem": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "crystalDeposits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "driveAssembly": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frozenGases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gateNode": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "helium3": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metalOre": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "optics": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "powerCore": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rareEarthMinerals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reactorRods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "researchLab": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconDust": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconWafers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "structuralFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volcanicSulfur": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waterIce": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "job": {
      "$ref": "#/$defs/ShipJob"
    },
    "max_cargo_capacity": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_fuel": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "max_survey_depth": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "position": {
      "$ref": "#/$defs/SystemPosition"
    },
    "role": {
      "$ref": "#/$defs/ShipRole"
    },
    "state": {
      "$ref": "#/$defs/ShipState"
    },
    "survey_work_per_tick": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "tier": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "travel_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/TravelPlan"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "display_name",
    "role",
    "tier",
    "position",
    "base_speed_milli",
    "base_mass",
    "cargo_amount",
    "max_cargo_capacity",
    "build_cargo_capacity",
    "fuel",
    "fuel_remainder",
    "fuel_efficiency_remainder",
    "max_fuel",
    "build_work_per_tick",
    "survey_work_per_tick",
    "max_survey_depth",
    "state",
    "job"
  ],
  "$defs": {
    "ArcDirection": {
      "description": "Direction along a lane arc.",
      "type": "string",
      "enum": [
        "clockwise",
        "counterClockwise"
      ]
    },
    "BodyId": {
      "description": "Unique identifier for a celestial body (e.g. `planet_haven`).",
      "type": "string"
    },
    "BuildOrderId": {
      "description": "Unique identifier for a build order.",
      "type": "string"
    },
    "DestinationRef": {
      "description": "A destination for ship travel or logistics.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "body_id": {
              "$ref": "#/$defs/BodyId"
            },
            "type": {
              "type": "string",
              "const": "body"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "body_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "station"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "salvage_id": {
              "$ref": "#/$defs/SalvageId"
            },
            "type": {
              "type": "string",
              "const": "salvage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "salvage_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gateSite"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "InventoryDestinationRef": {
      "description": "A destination for cargo delivery (inventory transfers).",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "station"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/BuildOrderId"
            },
            "type": {
              "type": "string",
              "const": "buildOrder"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/BuildOrderId"
            },
            "type": {
              "type": "string",
              "const": "evacuation"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "gateSite"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "InventorySourceRef": {
      "description": "A source for cargo pickup.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "station"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "salvage_id": {
              "$ref": "#/$defs/SalvageId"
            },
            "type": {
              "type": "string",
              "const": "salvage"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "salvage_id"
          ]
        }
      ]
    },
    "LaneId": {
      "description": "Orbital lane identifiers in increasing orbital radius order.",
      "type": "string",
      "enum": [
        "inner",
        "habitable",
        "outer",
        "fringe"
      ]
    },
    "ReservationId": {
      "description": "Unique identifier for a logistics reservation.",
      "type": "string"
    },
    "ResourceType": {
      "description": "The 25 resource types in canonical order (raw, refined, component).\n\nSerialized as a camelCase string (e.g. `\"metalOre\"`).  This enum's\n`Ord` follows the GDD 14 resource catalog order so that sparse maps\niterate deterministically.",
      "type": "string",
      "enum": [
        "metalOre",
        "carbonSoil",
        "siliconDust",
        "volcanicSulfur",
        "waterIce",
        "frozenGases",
        "helium3",
        "rareEarthMinerals",
        "crystalDeposits",
        "metals",
        "carbonFiber",
        "siliconWafers",
        "chemicals",
        "fuel",
        "alloys",
        "optics",
        "reactorRods",
        "structuralFrame",
        "powerCore",
        "controlSystem",
        "driveAssembly",
        "cargoModule",
        "researchLab",
        "constructionBay",
        "gateNode"
      ]
    },
    "SalvageId": {
      "description": "Unique identifier for a salvage cache.",
      "type": "string"
    },
    "ShipId": {
      "description": "Unique identifier for a ship (e.g. `ship_builder_1`).",
      "type": "string"
    },
    "ShipJob": {
      "description": "The job a ship is performing.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "idle"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "amount": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "destination": {
              "$ref": "#/$defs/InventoryDestinationRef"
            },
            "reservation_id": {
              "$ref": "#/$defs/ReservationId"
            },
            "resource": {
              "$ref": "#/$defs/ResourceType"
            },
            "source": {
              "$ref": "#/$defs/InventorySourceRef"
            },
            "stage": {
              "$ref": "#/$defs/TransportStage"
            },
            "type": {
              "type": "string",
              "const": "transport"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "reservation_id",
            "source",
            "destination",
            "resource",
            "amount",
            "stage"
          ]
        },
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "refuel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/BuildOrderId"
            },
            "type": {
              "type": "string",
              "const": "build"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/BuildOrderId"
            },
            "type": {
              "type": "string",
              "const": "upgrade"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/BuildOrderId"
            },
            "type": {
              "type": "string",
              "const": "demolish"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "#/$defs/SurveyOrderId"
            },
            "type": {
              "type": "string",
              "const": "survey"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "order_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "station_id": {
              "$ref": "#/$defs/StationId"
            },
            "tech_id": {
              "$ref": "#/$defs/TechId"
            },
            "type": {
              "type": "string",
              "const": "dockForResearch"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "station_id",
            "tech_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "dispatch_ticks_remaining": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "hub_id": {
              "$ref": "#/$defs/StationId"
            },
            "type": {
              "type": "string",
              "const": "rescue"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "hub_id",
            "dispatch_ticks_remaining"
          ]
        }
      ]
    },
    "ShipRole": {
      "description": "Role of a ship.",
      "type": "string",
      "enum": [
        "cargo",
        "construction",
        "research"
      ]
    },
    "ShipState": {
      "description": "Possible states of a ship.",
      "type": "string",
      "enum": [
        "idle",
        "holding",
        "inTransit",
        "building",
        "surveying",
        "poweringResearch",
        "awaitingRescue"
      ]
    },
    "StationId": {
      "description": "Unique identifier for a station (e.g. `hub_haven`).",
      "type": "string"
    },
    "SurveyOrderId": {
      "description": "Unique identifier for a survey order.",
      "type": "string"
    },
    "SystemPosition": {
      "description": "A position within the system: lane, orbital radius, and angle.",
      "type": "object",
      "properties": {
        "angle_milli": {
          "description": "Normalized 0..6282 milliradians (π × 2000).",
          "type": "integer",
          "format": "int32"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "radius_units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "lane_id",
        "radius_units",
        "angle_milli"
      ]
    },
    "TechId": {
      "description": "Unique identifier for a technology.",
      "type": "string"
    },
    "TransportStage": {
      "description": "Stage of a Transport job.",
      "type": "string",
      "enum": [
        "toPickup",
        "toDelivery"
      ]
    },
    "TravelPlan": {
      "description": "A ship's full travel plan from origin to destination.",
      "type": "object",
      "properties": {
        "active_segment": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "destination": {
          "$ref": "#/$defs/DestinationRef"
        },
        "origin": {
          "$ref": "#/$defs/SystemPosition"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TravelSegment"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "origin",
        "destination",
        "segments",
        "active_segment"
      ]
    },
    "TravelSegment": {
      "description": "One segment of a ship's travel plan.",
      "type": "object",
      "properties": {
        "arc_direction": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArcDirection"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/TravelSegmentKind"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "life_support_eligible": {
          "type": "boolean"
        },
        "remaining_distance_milli": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "speed_multiplier_den": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "speed_multiplier_num": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "total_distance_milli": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "lane_id",
        "total_distance_milli",
        "remaining_distance_milli",
        "speed_multiplier_num",
        "speed_multiplier_den",
        "life_support_eligible"
      ]
    },
    "TravelSegmentKind": {
      "description": "Kind of a single travel segment.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "radialBurn"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "laneArc"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    }
  }
}