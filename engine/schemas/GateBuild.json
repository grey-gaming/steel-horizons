{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GateBuild",
  "description": "The Space Gate build state during assembly.",
  "type": "object",
  "properties": {
    "components_delivered": {
      "type": "object",
      "properties": {
        "alloys": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonFiber": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "carbonSoil": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "cargoModule": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "chemicals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "constructionBay": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "controlSystem": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "crystalDeposits": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "driveAssembly": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "frozenGases": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "fuel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "gateNode": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "helium3": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metalOre": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "metals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "optics": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "powerCore": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "rareEarthMinerals": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "reactorRods": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "researchLab": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconDust": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "siliconWafers": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "structuralFrame": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "volcanicSulfur": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "waterIce": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "fabricator_ship_id": {
      "$ref": "#/$defs/ShipId"
    },
    "phase": {
      "$ref": "#/$defs/GatePhase"
    },
    "progress_work": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "site_position": {
      "$ref": "#/$defs/SystemPosition"
    }
  },
  "additionalProperties": false,
  "required": [
    "site_position",
    "phase",
    "fabricator_ship_id",
    "progress_work"
  ],
  "$defs": {
    "GatePhase": {
      "description": "Space Gate assembly phases.",
      "type": "string",
      "enum": [
        "sitePreparation",
        "frameAssembly",
        "powerIntegration",
        "activation"
      ]
    },
    "LaneId": {
      "description": "Orbital lane identifiers in increasing orbital radius order.",
      "type": "string",
      "enum": [
        "inner",
        "habitable",
        "outer",
        "fringe"
      ]
    },
    "ShipId": {
      "description": "Unique identifier for a ship (e.g. `ship_builder_1`).",
      "type": "string"
    },
    "SystemPosition": {
      "description": "A position within the system: lane, orbital radius, and angle.",
      "type": "object",
      "properties": {
        "angle_milli": {
          "description": "Normalized 0..6282 milliradians (π × 2000).",
          "type": "integer",
          "format": "int32"
        },
        "lane_id": {
          "$ref": "#/$defs/LaneId"
        },
        "radius_units": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "lane_id",
        "radius_units",
        "angle_milli"
      ]
    }
  }
}