  "$defs": {
    "RationalRemainder": {
      "description": "Rational remainder for accumulator-based resource consumption.",
      "type": "object",
      "properties": {
        "denominator": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "value": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "denominator"
      ]
    },
    "ResearchPauseReason": {
      "description": "Reason a research project was paused.",
      "type": "string",
      "enum": [
        "manual",
        "noResearchShip",
        "facilityUnavailable"
      ]
    },
    "ResearchState": {
      "description": "Research project lifecycle states.",
      "type": "string",
      "enum": [
        "awaitingMaterials",
        "ready",
        "active",
        "paused",
        "complete"
      ]
    },
    "StationId": {
      "description": "Unique identifier for a station (e.g. `hub_haven`).",
      "type": "string"
    },
    "TechId": {
      "description": "Unique identifier for a technology.",
      "type": "string"
    }
